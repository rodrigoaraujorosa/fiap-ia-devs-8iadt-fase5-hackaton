# .env de PRODUÇÃO: crie em /opt/imobiq/.env na EC2 (pelo Session Manager) e nunca o coloque no Git.
# Parte do que o app precisa (banco, URLs públicas, proxy) o docker-compose.prod.yml já define.

DOMAIN=imobiq.arrtsoftware.com.br
POSTGRES_PASSWORD=          # senha forte (ex.: openssl rand -base64 24)
ADMIN_PASSWORD=             # senha das telas de configurações e observabilidade

# Claude
ANTHROPIC_API_KEY=

# Langfuse (os traces entram como ambiente "production")
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# E-mail aos corretores (Hostinger)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SSL=true
SMTP_USER=laris@arrtsoftware.com.br
SMTP_PASSWORD=
EMAIL_FROM="Laris · ImobiQ <laris@arrtsoftware.com.br>"
EMAIL_DEMO_RECIPIENT=corretor@arrtsoftware.com.br

# Telegram: em produção, webhook (o Telegram chama a API pela URL pública)
# Atenção: com o mesmo bot rodando localmente em polling, a API local apaga o webhook ao subir.
# Localmente, deixe TELEGRAM_BOT_TOKEN vazio (ou use outro bot) depois do deploy.
TELEGRAM_BOT_TOKEN=
TELEGRAM_MODE=webhook
TELEGRAM_WEBHOOK_URL=https://imobiq.arrtsoftware.com.br/api/webhooks/telegram
TELEGRAM_WEBHOOK_SECRET=    # ex.: openssl rand -hex 32
TELEGRAM_BRAND="Imobiliária Exemplo"
PUBLIC_SITE_URL=https://imobiliaria-exemplo.arrtsoftware.com.br

# Widget: domínios iniciais (a tela de configurações altera em tempo real)
WIDGET_RESTRICT_DOMAINS=true
WIDGET_ALLOWED_DOMAINS=["imobiliaria-exemplo.arrtsoftware.com.br"]

USD_BRL=5.40

# ------------------------------------------------------------------ opcionais
# Sem estas linhas valem os padrões do código. Descomente só o que quiser mudar.

# Modelos do Claude
# LLM_MAIN_MODEL=claude-sonnet-5
# LLM_FAST_MODEL=claude-haiku-4-5

# Valores iniciais: depois do primeiro deploy, a tela de configurações altera em tempo real
# FOLLOWUP_ENABLED=true
# FOLLOWUP_MINUTES=2
# FOLLOWUP_MAX_ATTEMPTS=3
# FOLLOWUP_CHECK_SECONDS=30
# EMAIL_ENABLED=true
# EMAIL_DEMO_MODE=true
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_CONVERSATION_HOUR=40
# RATE_LIMIT_IP_HOUR=80
# RATE_LIMIT_SESSIONS_IP_HOUR=10
# RATE_LIMIT_DAILY_TOTAL=1500

# Não coloque aqui: o docker-compose.prod.yml já define (e sobrescreve) DATABASE_URL, ENVIRONMENT,
# EMBEDDING_CACHE_DIR, PUBLIC_APP_URL, CORS_ORIGINS e TRUST_PROXY_HEADERS.
# API_PORT, DB_PORT e WEB_PORT só existem no Docker local (em produção, só o Caddy nas portas 80/443).
