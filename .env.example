# Portas no host (3000/8000 costumam estar ocupadas no Windows)
DB_PORT=5432
API_PORT=8001
WEB_PORT=3001

# Banco (execução local fora do Docker)
DATABASE_URL=postgresql+psycopg://sdr:sdr@127.0.0.1:5432/sdr

# Anthropic (Dia 2+)
ANTHROPIC_API_KEY=
LLM_MAIN_MODEL=claude-sonnet-5
LLM_FAST_MODEL=claude-haiku-4-5

# Follow-up automático: 1ª tentativa após N minutos sem resposta, depois 2N, 4N...
# (2 min é bom para demo; em produção algo como 1440 = 24h)
FOLLOWUP_ENABLED=true
FOLLOWUP_MINUTES=2
FOLLOWUP_MAX_ATTEMPTS=3
FOLLOWUP_CHECK_SECONDS=30

# Observabilidade — Langfuse (opcional; vazio = desabilitado). Crie as chaves em https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Cache local do modelo de embeddings (no Docker é /models)
EMBEDDING_CACHE_DIR=.models
