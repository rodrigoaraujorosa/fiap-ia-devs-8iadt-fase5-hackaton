# Portas no host (3000/8000 costumam estar ocupadas no Windows)
DB_PORT=5432
API_PORT=8001
WEB_PORT=3001

# Banco (execução local fora do Docker)
DATABASE_URL=postgresql+psycopg://sdr:sdr@127.0.0.1:5432/sdr

# Anthropic
ANTHROPIC_API_KEY=
LLM_MAIN_MODEL=claude-sonnet-5
LLM_FAST_MODEL=claude-haiku-4-5

# Follow-up automático: 1ª tentativa após N minutos sem resposta, depois 2N, 4N...
# (2 min é bom para demo; em produção algo como 1440 = 24h)
# Valores iniciais: a tela /configuration altera enabled, minutos e tentativas em tempo real
FOLLOWUP_ENABLED=true
FOLLOWUP_MINUTES=2
FOLLOWUP_MAX_ATTEMPTS=3
FOLLOWUP_CHECK_SECONDS=30

# E-mail aos corretores (resumo + convite de calendário)
# Sem nada aqui, os e-mails vão para o Mailpit local: http://localhost:8025 (nada sai de verdade).
# Para enviar de verdade pela Hostinger, descomente e preencha (a senha é a da caixa remetente):
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465
# SMTP_SSL=true
# SMTP_USER=laris@arrtsoftware.com.br
# SMTP_PASSWORD=
EMAIL_FROM="Laris · ImobiQ <laris@arrtsoftware.com.br>"
# Valores iniciais: a tela /configuration altera em tempo real. No modo demonstração,
# todos os e-mails vão para a caixa abaixo (o corretor de destino aparece no assunto).
EMAIL_ENABLED=true
EMAIL_DEMO_MODE=true
EMAIL_DEMO_RECIPIENT=corretor@arrtsoftware.com.br
PUBLIC_APP_URL=http://localhost:3001

# Senha da tela de configurações (liga/desliga da IA, follow-up, e-mail, Telegram, reset da demo).
# Vazia = sem senha (uso local). Em produção, use uma senha forte; trocar a senha derruba as sessões abertas.
ADMIN_PASSWORD=

# Limites de mensagens e domínios do widget: valores iniciais (a tela de configurações altera em tempo real).
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_CONVERSATION_HOUR=40
# RATE_LIMIT_IP_HOUR=80
# RATE_LIMIT_SESSIONS_IP_HOUR=10
# RATE_LIMIT_DAILY_TOTAL=1500
# WIDGET_RESTRICT_DOMAINS=false
# WIDGET_ALLOWED_DOMAINS=["localhost:5500","127.0.0.1:5500"]
# Produção atrás do Caddy: o IP do visitante vem no X-Forwarded-For (sem proxy, deixe false)
TRUST_PROXY_HEADERS=false

# Telegram — bot da Laris (opcional). Crie o bot no @BotFather (/newbot) e cole o token aqui.
# Local: polling (a API busca as mensagens; não precisa de URL pública).
# Produção: TELEGRAM_MODE=webhook + URL pública HTTPS + segredo (conferido no cabeçalho de cada chamada).
TELEGRAM_BOT_TOKEN=
TELEGRAM_MODE=polling
# TELEGRAM_WEBHOOK_URL=https://imobiq.arrtsoftware.com.br/api/webhooks/telegram
# TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BRAND="Imobiliária Exemplo"
PUBLIC_SITE_URL=http://localhost:5500

# Observabilidade — Langfuse (opcional; vazio = desabilitado). Crie as chaves em https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Cache local do modelo de embeddings (no Docker é /models)
EMBEDDING_CACHE_DIR=.models
