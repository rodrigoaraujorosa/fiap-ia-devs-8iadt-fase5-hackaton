# Portas no host (3000/8000 costumam estar ocupadas no Windows)
DB_PORT=5432
API_PORT=8001
WEB_PORT=3001

# Banco (execução local fora do Docker)
DATABASE_URL=postgresql+psycopg://sdr:sdr@127.0.0.1:5432/sdr

# Anthropic (Dia 2+)
ANTHROPIC_API_KEY=
LLM_MAIN_MODEL=claude-sonnet-5
LLM_FAST_MODEL=claude-haiku-4-5

# Follow-up automático (minutos sem resposta do lead)
FOLLOWUP_MINUTES=2
FOLLOWUP_MAX_ATTEMPTS=3

# Observabilidade — Langfuse (Dia 3+)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Cache local do modelo de embeddings (no Docker é /models)
EMBEDDING_CACHE_DIR=.models
